use serde::Serialize;
use serde_json::Value;
use sha2::{Digest, Sha256};

#[derive(Serialize)]
struct VectorSuccess {
    status: &'static str,
    input: String,
    input_sha256: String,
    canonical_bytes_len: usize,
    canonical_bytes_utf8: String,
    canonical_bytes_hex: String,
    sha256_canonical_bytes: String,
    leaf_preimage_hex: String,
    leaf_preimage_len: usize,
    leaf_sha256: String,
}

#[derive(Serialize)]
struct VectorFailure {
    status: &'static str,
    input: String,
    input_sha256: String,
    error: String,
}

#[derive(Serialize)]
#[serde(untagged)]
enum VectorResult {
    Success(VectorSuccess),
    Failure(VectorFailure),
}

#[derive(Serialize)]
struct Output {
    d1_v02: VectorResult,
    d1_v03: VectorResult,
}

fn hex(bytes: &[u8]) -> String {
    const HEX: &[u8; 16] = b"0123456789abcdef";
    let mut out = String::with_capacity(bytes.len() * 2);
    for &b in bytes {
        out.push(HEX[(b >> 4) as usize] as char);
        out.push(HEX[(b & 0x0f) as usize] as char);
    }
    out
}

fn sha256_hex(bytes: &[u8]) -> String {
    let digest = Sha256::digest(bytes);
    hex(&digest)
}

fn execute(input: &str) -> VectorResult {
    let input_sha256 = sha256_hex(input.as_bytes());
    let parsed: Value = match serde_json::from_str(input) {
        Ok(v) => v,
        Err(e) => {
            return VectorResult::Failure(VectorFailure {
                status: "EXECUTION_NOT_AVAILABLE",
                input: input.to_owned(),
                input_sha256,
                error: format!("serde_json parse error: {e}"),
            })
        }
    };
    let canonical = match serde_json_canonicalizer::to_string(&parsed) {
        Ok(v) => v,
        Err(e) => {
            return VectorResult::Failure(VectorFailure {
                status: "EXECUTION_NOT_AVAILABLE",
                input: input.to_owned(),
                input_sha256,
                error: format!("canonicalization error: {e}"),
            })
        }
    };
    let canonical_bytes = canonical.as_bytes();
    let mut leaf_preimage = Vec::with_capacity(canonical_bytes.len() + 1);
    leaf_preimage.push(0x00);
    leaf_preimage.extend_from_slice(canonical_bytes);
    VectorResult::Success(VectorSuccess {
        status: "EXECUTED",
        input: input.to_owned(),
        input_sha256,
        canonical_bytes_len: canonical_bytes.len(),
        canonical_bytes_utf8: canonical,
        canonical_bytes_hex: hex(canonical_bytes),
        sha256_canonical_bytes: sha256_hex(canonical_bytes),
        leaf_preimage_hex: hex(&leaf_preimage),
        leaf_preimage_len: leaf_preimage.len(),
        leaf_sha256: sha256_hex(&leaf_preimage),
    })
}

fn main() {
    let output = Output {
        d1_v02: execute(r#"{"é":1,"z":2,"😀":3,"ﬀ":4}"#),
        d1_v03: execute(r#"{"a":-0.0}"#),
    };
    println!("{}", serde_json::to_string_pretty(&output).unwrap());
}

